# WORLDMARK NAICOM RETURNS MANAGEMENT SYSTEM
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it holds secrets.

# --- Supabase (required) ---
# Project URL, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (safe to expose to the browser; used with RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY. Never used in client code.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Canonical site URL (Vercel / production domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cron (Phase 6 reminders) ---
# Shared secret protecting /api/cron/* routes
CRON_SECRET=
