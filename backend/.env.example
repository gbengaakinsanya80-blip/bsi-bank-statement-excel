# Copy to backend/.env for local overrides (all values optional; defaults are safe).
# BSI_DATA_DIR defaults to <repo>/backend/data
# BSI_OCR_DPI=150
# BSI_MAX_PAGES=1000
# BSI_MAX_WORKERS=2
# Set DATABASE_URL to a Postgres connection string (e.g. Neon free tier) to
# persist job history instead of the local SQLite file:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- Billing (Paystack) ----------------------------------------------------
# Create a Paystack account (https://paystack.com) and grab keys from the
# dashboard. Create two recurring monthly plans (Pro and Business) and put
# their plan codes below. Prices default to ₦2,500 (Pro) and ₦5,000 (Business).
# PAYSTACK_SECRET_KEY=sk_test_xxx
# PAYSTACK_PUBLIC_KEY=pk_test_xxx
# PAYSTACK_WEBHOOK_SECRET=xxx  (from Dashboard -> Settings -> API Keys & Webhooks)
# PAYSTACK_PLAN_PRO=PLN_xxx
# PAYSTACK_PLAN_BUSINESS=PLN_xxx
# BSI_PRO_PRICE_KOBO=250000
# BSI_BUSINESS_PRICE_KOBO=500000
# BSI_FREE_MONTHLY_LIMIT=3
